# Copy to .env.production before production launch
JWT_SECRET=replace-with-strong-random-secret
CLIENT_ORIGIN=https://your-domain.example
# Reverse proxies in front of the backend: host nginx (deploy/) + bundled nginx = 2
TRUST_PROXY=2
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Per-IP limit on public request submissions
REQUEST_RATE_LIMIT_WINDOW_MS=3600000
REQUEST_RATE_LIMIT_MAX=10
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FAILED_ATTEMPT_TTL_MINUTES=60
AUTH_TOKEN_TTL=1d
# Required to read /api/metrics (send as x-metrics-token header)
METRICS_TOKEN=replace-with-strong-random-token

# Optional admin seed values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Ops Admin
