# Backend
MONGODB_URI=mongodb://localhost:27017/forHumanity
JWT_SECRET=change-me
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the backend (0 = none)
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Per-IP limit on public request submissions
REQUEST_RATE_LIMIT_WINDOW_MS=3600000
REQUEST_RATE_LIMIT_MAX=10
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FAILED_ATTEMPT_TTL_MINUTES=60
AUTH_TOKEN_TTL=1d
# Optional locally; required to read /api/metrics in production
METRICS_TOKEN=

# Frontend
# Copy frontend/.env.example to frontend/.env and adjust as needed

# Email notifications (optional; off unless SMTP_HOST is set). Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=forHumanity <no-reply@your-domain.example>
# Public URL of the app, used for links in emails
APP_URL=http://localhost:3000

# Days after delivery/cancellation before requesters' personal details are removed (off = never)
RETENTION_DAYS=90
